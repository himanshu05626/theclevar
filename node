name: 🚀 Deploy Next.js (Main + Stag - Private Repo)

on:
  push:
    branches:
      - main
      - stag

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Checkout Code
        uses: actions/checkout@v4

      - name: 🔐 Setup SSH
        uses: webfactory/ssh-agent@v0.8.0
        with:
          ssh-private-key: ${{ secrets.SSH_KEY }}

      - name: 🚀 Deploy to VPS
        run: |
          BRANCH_NAME="${GITHUB_REF#refs/heads/}"
          echo "Branch detected: $BRANCH_NAME"

          ssh -T -o StrictHostKeyChecking=no ${{ secrets.USERNAME }}@${{ secrets.HOST }} "
            export PATH=/www/server/nodejs/v22.17.1/bin:\$PATH

            if [ \"$BRANCH_NAME\" = \"main\" ]; then
              APP_DIR=/www/wwwroot/theclevar
              PM2_NAME=clevar
              PORT=3000
            else
              APP_DIR=/www/wwwroot/theclevarstag
              PM2_NAME=clevarstag
              PORT=3001
            fi

            echo '🚀 Deploying branch:' $BRANCH_NAME
            echo '📁 Directory:' \$APP_DIR

            # If folder doesn't exist → clone via SSH
            if [ ! -d \$APP_DIR ]; then
              git clone -b $BRANCH_NAME git@github.com:himanshu05626/theclevar.git \$APP_DIR
            fi

            cd \$APP_DIR || exit 1

            # Ensure correct remote (important for old HTTPS clones)
            git remote set-url origin git@github.com:himanshu05626/theclevar.git

            # Pull latest code
            git fetch origin
            git reset --hard origin/$BRANCH_NAME

            # Install deps
            npm ci

            # Prisma
            npx prisma generate

            # Build
            npm run build

            # Start or reload PM2
            if pm2 describe \$PM2_NAME > /dev/null; then
              echo '🔄 Reloading' \$PM2_NAME
              pm2 reload \$PM2_NAME --update-env
            else
              echo '🆕 Starting' \$PM2_NAME
              PORT=\$PORT pm2 start npm --name \$PM2_NAME -- start
            fi

            pm2 save

            echo '✅ Deployment Complete'
          "

          Delete your other nameservers:
ns1.dns-parking.com

ns2.dns-parking.com